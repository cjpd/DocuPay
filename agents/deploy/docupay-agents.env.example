# Copy to /etc/docupay-agents.env, then: chmod 600 /etc/docupay-agents.env; chown dpagent: /etc/docupay-agents.env
# Never commit the real file. The agent never prints these values.

# GitHub: a fine-grained token for cjpd/DocuPay only.
# Permissions: Contents read/write (push agent/* branches), Issues read/write (labels), Pull requests read/write (draft PRs).
GITHUB_TOKEN=
GITHUB_REPO=cjpd/DocuPay
GITHUB_OWNER_LOGIN=cjpd
DP_BASE_BRANCH=main

# Telegram: a BotFather bot and your own chat id (see deploy/README.md).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard: 32+ random characters. Make one with: openssl rand -hex 24
DASHBOARD_TOKEN=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# Opus runs through Claude Code headless with the dpagent user's Claude login.
OPUS_MODEL=claude-opus-5-5
# CLAUDE_BIN=/usr/local/bin/claude

# Paths
DP_AGENTS_ENV=/etc/docupay-agents.env
DP_AGENTS_DB=/srv/docupay/agents/data/state.sqlite3
DP_AGENTS_WORK=/srv/docupay/agents/work
REPORT_HOUR=17
HOURS_PER_POINT=1.0
