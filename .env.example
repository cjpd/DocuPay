# Copy to .env and change the values. Never commit .env.

# Django. The app refuses to start without DEBUG=1 unless the key has 32+ random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Browser sign-in (httpOnly session cookie). Host the frontend and the API on the same
# site, for example app.example.com and api.example.com.
COOKIE_SECURE=0
SESSION_HOURS=12
LOGIN_RATE_LIMIT=10/min

# Database
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Queue
REDIS_URL=redis://redis:6379/0

# Storage (leave empty to use local disk)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=

# Extraction pipeline
# heuristic = offline regex (no key, low accuracy) | anthropic | openai
EXTRACTION_PROVIDER=heuristic
# Retry with the strong model when the fast result fails the checks
EXTRACTION_ESCALATE=1
PROCESSING_MAX_PAGES=20
PROCESSING_MAX_FILE_BYTES=20971520

# Claude (EXTRACTION_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
ANTHROPIC_STRONG_MODEL=claude-opus-5-5
ANTHROPIC_STRONG_EFFORT=medium
ANTHROPIC_REFUSAL_FALLBACKS=1

# OpenAI (EXTRACTION_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-5-mini
OPENAI_STRONG_MODEL=gpt-5
# Optional, for cost tracking: {"gpt-5-mini": [input $/MTok, output $/MTok]}
OPENAI_PRICING={}
